    { "from": "elicitation", "to": "gap-analysis" },
    { "from": "gap-analysis", "to": "domain-modeling" },
    {
      "from": "domain-modeling",
      "to": "context-artifact",
      "label": "inline update",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "top"
    },
    { "from": "domain-modeling", "to": "risk-scan" },
    { "from": "risk-scan", "to": "spec-writer" },
    { "from": "spec-writer", "to": "spec-validator" },
    {
      "from": "spec-validator",
      "to": "handover",
      "label": "IEEE 29148 pass",
      "variant": "emphasis"
    },
    {
      "from": "spec-validator",
      "to": "spec-writer",
      "label": "loop on failure",
      "variant": "security",
      "route": "outside-right",
      "fromSide": "bottom",
      "toSide": "bottom"
    }
