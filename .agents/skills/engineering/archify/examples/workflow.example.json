      "lane": "ba-core",
      "col": 3,
      "type": "backend",
      "label": "Domain Modeling",
      "sublabel": "RBAC + FSM + ERD",
      "tag": "Stage 4"
    },
    {
      "id": "risk-scan",
      "lane": "ba-core",
      "col": 3,
      "type": "security",
      "label": "Risk Scanner",
      "sublabel": "MoSCoW + RISK-",
      "tag": "Stage 5"
    },
    {
      "id": "spec-writer",
      "lane": "ba-core",
      "col": 4,
