      "toSide": "top"
    },
    { "from": "micro-fast-track", "to": "code-fix" },
    { "from": "code-fix", "to": "verify" },
    {
      "from": "elicitation",
      "to": "user-interview",
      "label": "grilling 2-3 Qs",
      "variant": "security",
      "route": "drop",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "user-interview",
      "to": "elicitation",
      "label": "confirmed answers",
      "variant": "default",
      "fromSide": "top",
      "toSide": "bottom"
