        "label": "Elicitation interview gate",
        "focus": [
          "intake",
          "elicitation",
          "user-interview",
          "spec-writer",
          "handover"
        ],
        "note": "Isolate the mandatory human interview gate that blocks all downstream stages."
      },
      {
        "id": "fast-track",
        "label": "Micro-task fast-track",
        "focus": ["intake", "micro-fast-track", "code-fix", "verify"],
        "note": "See the bypass route for surgical changes under 30 lines."
