  "cards": [
    {
      "dot": "rose",
      "title": "Zero-Hallucination Policy",
      "items": [
        "AI MUST pause at Stage 2 for live customer interview",
        "Strictly forbidden from inventing business rules",
        "All ASM- assumptions must be confirmed by user"
      ]
    },
    {
      "dot": "emerald",
      "title": "Routing by Complexity",
      "items": [
        "Micro-Task: bypass BA ceremony, direct to TDD fast-track",
        "Bounded Task: Stages 1,2,4,5,6,7,8 (skip gap analysis)",
        "Full Feature/Epic: all 8 stages at full depth"
      ]
    },
    {
      "dot": "cyan",
      "title": "Artifacts Produced",
      "items": [
        "CONTEXT.md updated with confirmed terminology",
        "adr/ records load-bearing architectural decisions",
        "baseline.md SIGNED-OFF v1.0 gates all downstream work"
      ]
    }
  ]
