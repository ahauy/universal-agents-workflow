+            for name in scripts:
+                shutil.copy2(ROOT / '.agents/scripts' / name, source / '.agents/scripts' / name)
+            (source / 'AGENTS.md').write_text('new source instructions')
+            (target / 'sentinel.txt').write_text('unchanged')
