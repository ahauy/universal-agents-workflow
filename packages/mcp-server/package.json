{
  "name": "@universal-agents/mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for Universal Agents Workflow framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "uaw-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "universal-agents-workflow",
    "ai-agents",
    "prompt-engineering",
    "spec-driven"
  ],
  "author": "Universal Agents Workflow Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "commander": "^13.1.0",
    "diff": "^7.0.0",
    "fast-glob": "^3.3.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
